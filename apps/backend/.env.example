# QuickCart backend environment variables.
# The app runs zero-config out of the box (in-memory catalog + mock payment provider).
# Copy this file to .env only if you need to override a default locally.

# Comma-separated list of frontend origins allowed to call this API.
# Falls back to a permissive localhost default when unset.
ALLOWED_ORIGINS=http://localhost:5173

# Payment capability provider: "mock" (default, no network calls) or "stripe" for a real processor.
PAYMENT_PROVIDER=mock

# Required only when PAYMENT_PROVIDER=stripe. Get a TEST secret key from
# https://dashboard.stripe.com/test/apikeys - never commit a real value.
STRIPE_SECRET_KEY=
